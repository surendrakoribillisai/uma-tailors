# Twilio account credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Use ONE of these SMS sender options:
# Recommended when your Twilio setup supports it:
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Or use a Twilio phone number instead:
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# Used to hash OTPs in server memory. Change this to a long random secret.
OTP_HASH_SECRET=replace-with-a-long-random-secret

# Optional local port
PORT=3000
